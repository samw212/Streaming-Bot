{
  "name": "streaming-bot",
  "version": "0.1.0",
  "description": "A personal YouTube Music player bot driven by Playwright, controllable from the terminal, a REST API, or a web remote.",
  "type": "module",
  "bin": {
    "ytm-bot": "src/cli.ts"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "login": "node src/cli.ts login",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:unit": "node --test \"test/unit/**/*.test.ts\"",
    "test:integration": "node --test \"test/integration/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
